<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <PackageId>Rkd.Cnab</PackageId>
    <Version>1.0.1</Version>
    <Title>Rkd.Cnab</Title>
    <Authors>Rodrigo Kmiecik</Authors>
    <Company>rkd.com.br</Company>
    <Product>Rkd.Cnab</Product>
    <Copyright>Copyright (c) 2025 Rodrigo Kmiecik</Copyright>

    <PackageDescription>Biblioteca .NET orientada a configuração para converter arquivos CNAB 240/400 em um resultado estruturado (JSON). Os layouts são definidos no appsettings.json (identificação composta de registros, header/detalhe/trailer sem lógica fixa no código) e a resposta traz flags de validação (Success, CompletelyConverted) e lista detalhada de erros por linha. Configuration-driven CNAB 240/400 parser for .NET.</PackageDescription>
    <PackageTags>cnab;cnab240;cnab400;febraban;banking;parser;json;remessa;retorno;brasil;finance</PackageTags>
    <PackageReleaseNotes>1.0.1: README agora exibido na página do pacote no NuGet; descrição corrigida; dependências alinhadas ao .NET 8 (removidos pacotes não utilizados); validação estrutural do layout na criação do CnabConverter (fail-fast); tratamento de BOM no início do arquivo; documentação XML na API pública. Detalhes: https://github.com/rkdcoder/Rkd.Cnab/releases</PackageReleaseNotes>

    <RepositoryUrl>https://github.com/rkdcoder/Rkd.Cnab</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rkdcoder/Rkd.Cnab</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- A biblioteca só consome IConfiguration + binding. O host (ASP.NET Core, Worker, Console)
         é quem referencia os providers (ex.: Configuration.Json). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="Media\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
